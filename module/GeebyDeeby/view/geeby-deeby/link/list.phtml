<?php
    $this->layout()->title = $title;
?>
<?php if (!empty($desc)): ?><?=$desc?><?php endif; ?>
<?php if (count($links) < 1): ?>
  <p>No links listed in this database yet.</p>
<?php else: ?>
  <?php $type = false; ?>
  <?php foreach ($links as $i => $link): ?>
    <?php if ($type != $link['Link_Type']): $type = $link['Link_Type']; ?>
      <h2><?=$this->escapeHtml($type)?><a href="#" style="float:right">Back to Top &uarr;</a></h2>
    <?php endif; ?>
    <p class="link">
      <a href="<?=$this->escapeHtml($link['URL'])?>"><?=$this->fixtitle($link['Link_Name'])?></a><br />
      <?php if (!empty($link['Description'])): ?><?=$link['Description']?><br /><?php endif; ?>
      <span class="url"><?=$this->escapeHtml($link['URL'])?></span>
      <?php $date = $link['Date_Checked'] instanceof \DateTime ? $link['Date_Checked']->format('Y-m-d') : $link['Date_Checked']; ?>
      (last verified: <?=$this->escapeHtml($date)?>)
    </p>
  <?php endforeach; ?>
<?php endif; ?>
