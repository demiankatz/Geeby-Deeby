<?php $config = $this->config('search_controls') ?? []; ?>
<div class="col-md-3">
  <h2><?=$this->title ?></h2>
  <ol>
    <?php foreach ($this->items as $i => $current): ?>
      <li>
        <a href="<?=$this->url(strtolower($this->prefix), ['id' => $current[$this->prefix . '_ID']])?>">
          <?=$this->escapeHtml($this->fixtitle($current[$this->prefix . '_Name'] ?? $current[$this->prefix . '_AltName']))?>
        </a>
        <?php if ($this->prefix === 'Item'): ?>
          <div class="hidden creators" data-loaded="0" data-item-id="<?=$current[$this->prefix . '_ID']?>">
            <span class="values"></span>
          </div>
          <?php foreach (array_keys($config['edition_attributes'] ?? []) as $id): ?>
            <div class="hidden edition-attributes" data-loaded="0" data-edition-attribute-id="<?=$id?>" data-item-id="<?=$current[$this->prefix . '_ID']?>">
              <span class="values"></span>
            </div>
          <?php endforeach; ?>
        <?php endif; ?>
      </li>
    <?php endforeach; ?>
  </ol>
</div>