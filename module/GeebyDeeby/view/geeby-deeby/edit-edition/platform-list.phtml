<?php if (count($editionPlatforms ?? []) > 0): ?>
  <?php foreach ($editionPlatforms as $current): ?>
    <?php $platform = $current->getPlatform(); ?>
    <table class="list_item">
      <tr>
        <td>
          <?=$this->escapeHtml($platform->getPlatformName())?>
        </td>
        <td>
          <?=
            $this->iconButton(
                'trash',
                "Edition.unlink('Platform', " . $platform->getId() . ')',
                'Unlink platform: ' . $platform->getPlatformName()
            )
          ?>
        </td>
      </tr>
    </table>
  <?php endforeach ?>
<?php else: ?>
  No platforms set.
<?php endif; ?>
